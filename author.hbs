{{!< default}}
{{#author}}
<header class="phead wrap">
    <div class="pills"><span class="pill is-or">Author</span></div>
    <h1 class="ptitle"><span class="mis" data-text="{{name}}">{{name}}</span></h1>
    {{#if bio}}<p class="dek" data-detect-lang>{{bio}}</p>{{/if}}
</header>
{{/author}}
<section class="index wrap" aria-label="Posts">
    <ol class="rows" role="list" data-total="{{pagination.total}}" data-page="{{pagination.page}}" data-limit="{{pagination.limit}}" data-skip="0">
        {{#foreach posts}}{{> row}}{{/foreach}}
    </ol>
    {{pagination}}
</section>
