{{!< default}}
{{#post}}
<article class="{{post_class}}"{{#has tag="#zh-hans"}} lang="zh-Hans"{{/has}}>
    <header class="phead wrap">
        <div class="pills">
            <span class="pill">{{date format="MMM D, YYYY"}}</span>
            <span class="pill" data-reading-time>{{reading_time minute="1 min" minutes="% min"}}</span>
            {{#primary_tag}}<a class="pill is-or" href="{{url}}">{{name}}</a>{{/primary_tag}}
            {{#has tag="#bilingual"}}
                <span class="lang" role="group" aria-label="Language 語言" hidden>
                    <button type="button" class="pill" data-setlang="zh">中文</button>
                    <button type="button" class="pill" data-setlang="en">English</button>
                </span>
            {{/has}}
        </div>
        <h1 class="ptitle"><span class="mis" data-text="{{title}}" data-detect-lang>{{title}}</span></h1>
        {{#if custom_excerpt}}<p class="dek" data-detect-lang>{{custom_excerpt}}</p>{{/if}}
    </header>
    {{#if feature_image}}
        <figure class="feature wrap">
            <div class="print"><div class="duo">
                <img
                    srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 1600w"
                    sizes="(max-width: 1180px) 92vw, 1100px"
                    src="{{img_url feature_image size="l"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    data-duo>
            </div></div>
            <figcaption><span class="fig">Cover</span>{{#if feature_image_caption}}{{feature_image_caption}}{{/if}}</figcaption>
        </figure>
    {{/if}}
    <section class="gh-content"{{#has tag="#bilingual"}} data-bilingual{{/has}}>
        {{content}}
    </section>
    <footer class="pfoot">
        <div class="author">
            <p class="author-n">{{#foreach authors}}<a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}{{/foreach}}</p>
            {{#primary_author}}{{#if bio}}<p class="author-x" data-detect-lang>{{bio}}</p>{{/if}}{{/primary_author}}
        </div>
        {{#if comments}}<div class="comments">{{comments title="Comments" count=true mode="light"}}</div>{{/if}}
        <nav class="nb" aria-label="More posts">
            {{#prev_post}}<a href="{{url}}"><span class="nb-k">← Older</span><span class="nb-t" data-detect-lang>{{title}}</span></a>{{else}}<span></span>{{/prev_post}}
            {{#next_post}}<a class="is-next" href="{{url}}"><span class="nb-k">Newer →</span><span class="nb-t" data-detect-lang>{{title}}</span></a>{{else}}<span class="is-next nb-none">This is the latest issue</span>{{/next_post}}
        </nav>
    </footer>
</article>
{{/post}}
