{{#match pagination.pages ">" 1}}
<nav class="pagination" aria-label="Pages">
    {{#if pagination.prev}}<a class="pill" href="{{page_url pagination.prev}}">← Newer</a>{{else}}<span></span>{{/if}}
    <span class="pg">Page {{pagination.page}} of {{pagination.pages}}</span>
    {{#if pagination.next}}<a class="pill" href="{{page_url pagination.next}}">Older →</a>{{else}}<span></span>{{/if}}
</nav>
{{/match}}
