{{#if @site.members_enabled}}{{#unless @member}}{{#unless @site.members_invite_only}}
<section class="sub" aria-labelledby="sub-h">
    <div class="wrap sub-in">
        <h2 id="sub-h" class="sub-h">Get the next issue</h2>
{{#if @site.paid_members_enabled}}<div class="sub-f">{{> signup class="btn" label="Subscribe"}}</div>{{else if @site.portal_signup_checkbox_required}}<div class="sub-f">{{> signup class="btn" label="Subscribe"}}</div>{{else if @site.allow_self_signup}}
        <div class="sub-f" data-member-scope>
            <form class="sub-form" data-member-form="subscribe" novalidate>
                <label class="sr-only" for="sub-email">Email</label>
                <input id="sub-email" type="email" data-member-email placeholder="you@example.com" autocomplete="email" autocapitalize="off" spellcheck="false">
                <button class="btn" type="submit"><span class="go-idle">Subscribe</span><span class="go-busy">Sending…</span></button>
            </form>
            <p class="note note-success" aria-live="polite">Check <b data-member-echo></b> to confirm. 請到郵箱確認訂閱。</p>
            <p class="note note-error" data-member-error data-invalid="Enter a valid email address." data-fallback="That didn’t work. Try again." aria-live="assertive"></p>
        </div>
        {{else}}<div class="sub-f">{{> signup class="btn" label="Subscribe"}}</div>{{/if}}
    </div>
</section>
{{/unless}}{{/unless}}{{/if}}
