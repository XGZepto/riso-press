{{!-- Sign-in and subscribe, run by members.js: a sheet like the search index. --}}
{{#if @site.members_enabled}}
{{#unless @member}}
<div class="member" data-member-panel data-signup="{{#if @site.members_invite_only}}none{{else if @site.paid_members_enabled}}portal{{else if @site.portal_signup_checkbox_required}}portal{{else if @site.allow_self_signup}}theme{{else}}portal{{/if}}" data-mode="signup" hidden>
    <div class="member-backdrop" data-member-close></div>
    <section class="member-box" role="dialog" aria-modal="true" aria-labelledby="member-title">
        <div class="member-top">
            <h2 class="member-h" id="member-title"><span class="mis" data-text="Subscribe" data-for-mode="signup">Subscribe</span><span class="mis" data-text="Sign in" data-for-mode="signin" hidden>Sign in</span></h2>
            <button type="button" class="pill member-x" data-member-close aria-label="Close"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>

        <form class="member-form" data-member-form="signup" data-member-scope novalidate>
            <div class="member-ask">
                <label class="sr-only" for="member-signup-name">Name</label>
                <input id="member-signup-name" type="text" data-member-name autocomplete="name" placeholder="Name (optional)">
                <label class="sr-only" for="member-signup-email">Email</label>
                <input id="member-signup-email" type="email" data-member-email autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="you@example.com">
                <p class="member-error" data-member-error data-invalid="Enter a valid email address." data-fallback="That didn’t work. Try again." aria-live="assertive"></p>
                {{#if @site.portal_signup_terms_html}}<div class="member-terms">{{{@site.portal_signup_terms_html}}}</div>{{/if}}
                <div class="member-acts">
                    <button type="submit" class="btn"><span class="go-idle">Subscribe</span><span class="go-busy">Sending…</span></button>
                    <p class="member-switch">Already subscribed? <button type="button" data-member-mode="signin">Sign in</button></p>
                </div>
            </div>
            <div class="member-sent" aria-live="polite">
                <p class="member-big">Check your inbox</p>
                <p>Confirm with the link we sent to <b data-member-echo></b>. 請到郵箱確認訂閱。</p>
                <div class="member-acts"><button type="button" class="btn" data-member-close data-member-done>Done</button></div>
            </div>
        </form>

        <form class="member-form" data-member-form="signin" data-member-scope novalidate hidden>
            <div class="member-ask">
                <label class="sr-only" for="member-signin-email">Email</label>
                <input id="member-signin-email" type="email" data-member-email autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="you@example.com">
                <p class="member-error" data-member-error data-invalid="Enter a valid email address." data-fallback="That didn’t work. Try again." aria-live="assertive"></p>
                <div class="member-acts">
                    <button type="submit" class="btn"><span class="go-idle">Send link</span><span class="go-busy">Sending…</span></button>
                    {{#unless @site.members_invite_only}}<p class="member-switch">New here? {{> signup label="Subscribe" switch=true}}</p>{{/unless}}
                </div>
            </div>
            <div class="member-sent" aria-live="polite">
                <p class="member-big">Check your inbox</p>
                <p>Sign in with the link we sent to <b data-member-echo></b>. 請到郵箱打開連結登入。</p>
                <div class="member-acts"><button type="button" class="btn" data-member-close data-member-done>Done</button></div>
            </div>
        </form>
    </section>
</div>
{{/unless}}
<div class="member-note" data-member-note role="status" hidden>
    <p data-note="signin">Signed in{{#if @member.firstname}} — welcome back, {{@member.firstname}}{{/if}} · 登入成功</p>
    <p data-note="signup">You’re subscribed · 訂閱成功</p>
    <p data-note="fail">That link has expired{{#unless @member}} · <button type="button" data-member="signin" data-note-close>Send a new one</button>{{/unless}}</p>
    <button type="button" class="member-note-x" data-note-close aria-label="Dismiss">×</button>
</div>
{{/if}}
