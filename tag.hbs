{{!< default}}
{{#tag}}
<header class="phead wrap">
    <div class="pills"><span class="pill is-or">Tag</span></div>
    <h1 class="ptitle"><span class="mis" data-text="{{name}}" data-detect-lang>{{name}}</span></h1>
    {{#if description}}<p class="dek" data-detect-lang>{{description}}</p>{{/if}}
</header>
{{/tag}}
<section class="index wrap" aria-label="Posts">
    <ol class="rows" role="list" data-total="{{pagination.total}}" data-page="{{pagination.page}}" data-limit="{{pagination.limit}}" data-skip="0">
        {{#foreach posts}}{{> row}}{{/foreach}}
    </ol>
    {{pagination}}
</section>
