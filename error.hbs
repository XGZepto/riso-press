{{!< default}}
<header class="phead wrap err">
    <div class="pills"><span class="pill is-or">Misprint · {{statusCode}}</span></div>
    <h1 class="ptitle"><span class="mis" data-text="{{message}}">{{message}}</span></h1>
    <p class="dek">This page was never printed. 這一頁沒有印出來。</p>
    <p><a class="btn" href="{{@site.url}}">Back to the front page</a></p>
</header>
