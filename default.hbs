<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{{meta_title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Noto+Serif+TC:wght@400;600;900&family=Noto+Serif+SC:wght@400;600;900&family=Noto+Sans+TC:wght@700;900&family=Chiron+Sung+HK:ital,wght@1,400&family=JetBrains+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    <style>:root { --ink-1: {{@custom.first_ink}}; --ink-2: {{@custom.second_ink}}; }</style>
    {{ghost_head exclude="search"}}
</head>
<body class="{{body_class}}" data-default-lang="{{@custom.default_language}}" data-timezone="{{@site.timezone}}">
    <a class="skip-link" href="#main">Skip to content</a>
    {{> site-nav}}
    <main id="main">
        {{{body}}}
    </main>
    {{> subscribe}}
    {{> site-footer}}
    {{> search}}
    {{> member}}
    <script src="{{asset "js/search.js"}}" defer></script>
    <script src="{{asset "js/members.js"}}" defer></script>
    <script src="{{asset "js/main.js"}}" defer></script>
    {{ghost_foot}}
</body>
</html>
